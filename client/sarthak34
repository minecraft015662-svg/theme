#!/usr/bin/env bash
# Sarthak34 CLI - installs the licensed theme and extensions on a Pterodactyl panel.
set -uo pipefail
API="__API__"
PANEL="${PANEL_DIR:-/var/www/pterodactyl}"
CONF=/etc/sarthak34/license.conf
WRAP="$PANEL/resources/views/templates/wrapper.blade.php"
TDIR="$PANEL/public/themes/sarthak34"
BIN=/usr/local/bin/sarthak34

die(){ echo "Error: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root (sudo)."
for b in curl python3 tar; do command -v $b >/dev/null || die "$b is required."; done
[ -f "$WRAP" ] || die "Pterodactyl not found at $PANEL (set PANEL_DIR=/path)."

DOMAIN=$(grep -E '^APP_URL=' "$PANEL/.env" | head -1 | cut -d= -f2- | tr -d '"' | sed -E 's#^https?://##; s#[/:].*$##')
[ -n "$DOMAIN" ] || die "APP_URL missing in $PANEL/.env"

body(){ python3 -c 'import json,sys;print(json.dumps({"license":sys.argv[1],"email":sys.argv[2],"domain":sys.argv[3]}))' "$LIC" "$EMAIL" "$DOMAIN"; }
jget(){ python3 -c 'import json,sys;d=json.load(sys.stdin);print(d.get(sys.argv[1],""))' "$1"; }

load_conf(){ [ -f "$CONF" ] && . "$CONF"; LIC="${LIC:-}"; EMAIL="${EMAIL:-}"; }
ask_license(){
  read -rp "License key: " LIC; read -rp "Email: " EMAIL
  R=$(curl -sS -X POST -H 'Content-Type: application/json' -d "$(body)" "$API/api/activate") || die "cannot reach license server."
  [ "$(echo "$R" | jget ok)" = "True" ] || die "$(echo "$R" | jget error)"
  mkdir -p /etc/sarthak34; umask 077
  printf 'LIC=%q\nEMAIL=%q\n' "$LIC" "$EMAIL" > "$CONF"; chmod 600 "$CONF"
  echo "License verified for $DOMAIN."
}
need_license(){ load_conf; [ -n "$LIC" ] || ask_license; }

fetch(){ # fetch <package> <dest-dir>
  local tmp; tmp=$(mktemp)
  local code; code=$(curl -sS -o "$tmp" -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d "$(body)" "$API/api/package/$1")
  if [ "$code" != 200 ]; then echo "Error: $(jget error < "$tmp")" >&2; rm -f "$tmp"; return 1; fi
  mkdir -p "$2"; tar -xzf "$tmp" -C "$2"; rm -f "$tmp"
}

rebuild(){ # regenerate the loader block inside wrapper.blade.php
  [ -f "$WRAP.s34bak" ] || cp "$WRAP" "$WRAP.s34bak"
  python3 - "$WRAP" "$TDIR" <<'PY'
import os, re, sys, time
wrap, tdir = sys.argv[1], sys.argv[2]; v = int(time.time()); tags = []
if os.path.exists(f"{tdir}/theme.css"): tags.append(f'<link rel="stylesheet" href="/themes/sarthak34/theme.css?v={v}">')
ext = f"{tdir}/ext"
for n in (sorted(os.listdir(ext)) if os.path.isdir(ext) else []):
    if os.path.exists(f"{ext}/{n}/ext.css"): tags.append(f'<link rel="stylesheet" href="/themes/sarthak34/ext/{n}/ext.css?v={v}">')
    if os.path.exists(f"{ext}/{n}/ext.js"): tags.append(f'<script defer src="/themes/sarthak34/ext/{n}/ext.js?v={v}"></script>')
s = open(wrap).read()
s = re.sub(r"\n?<!-- sarthak34:start -->.*?<!-- sarthak34:end -->\n?", "\n", s, flags=re.S)
if tags: s = s.replace("</head>", "<!-- sarthak34:start -->\n" + "\n".join(tags) + "\n<!-- sarthak34:end -->\n</head>", 1)
open(wrap, "w").write(s)
PY
  (cd "$PANEL" && php artisan view:clear >/dev/null 2>&1)
}

cmd_install(){
  ask_license
  [ "$0" = "$BIN" ] || { cp "$0" "$BIN" 2>/dev/null && chmod +x "$BIN"; } || curl -sSL "$API/install.sh" -o "$BIN" && chmod +x "$BIN"
  fetch theme "$TDIR" || exit 1
  rebuild; echo "Sarthak34 theme installed. Hard refresh your browser (Ctrl+Shift+R)."
  echo "Extensions: sarthak34 ext list | sarthak34 ext install <name>"
}
cmd_update(){ need_license; fetch theme "$TDIR" || exit 1
  for d in "$TDIR"/ext/*/; do [ -d "$d" ] && fetch "$(basename "$d")" "$d"; done; rebuild; echo "Updated."; }
cmd_ext(){
  need_license
  case "${1:-}" in
    list) curl -sS -X POST -H 'Content-Type: application/json' -d "$(body)" "$API/api/extensions" |
      python3 -c 'import json,sys;d=json.load(sys.stdin);[print(f"{e[\"name\"]:<18} {e[\"description\"]}") for e in d.get("extensions",[])] if d.get("ok") else print("Error:",d.get("error"))';;
    install) [ -n "${2:-}" ] || die "usage: sarthak34 ext install <name>"; fetch "$2" "$TDIR/ext/$2" && rebuild && echo "Extension '$2' installed.";;
    remove) [ -n "${2:-}" ] || die "usage: sarthak34 ext remove <name>"; rm -rf "$TDIR/ext/$2"; rebuild; echo "Extension '$2' removed.";;
    *) die "usage: sarthak34 ext list|install <name>|remove <name>";;
  esac
}
cmd_uninstall(){ rm -rf "$TDIR"; rebuild; echo "Theme removed. (License file kept at $CONF)"; }
cmd_status(){ load_conf; echo "Panel: $PANEL ($DOMAIN)"; echo "License: ${LIC:-none} / ${EMAIL:-none}"
  [ -d "$TDIR" ] && { echo "Theme: installed"; ls "$TDIR/ext" 2>/dev/null | sed 's/^/Extension: /'; } || echo "Theme: not installed"; }

case "${1:-install}" in
  install) cmd_install;; update) cmd_update;; ext) shift; cmd_ext "$@";;
  uninstall) cmd_uninstall;; status) cmd_status;;
  *) echo "Usage: sarthak34 [install|update|status|uninstall|ext list|ext install <name>|ext remove <name>]";;
esac
